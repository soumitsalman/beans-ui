    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.1.0",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.33.0"
