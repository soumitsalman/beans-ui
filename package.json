{
  "name": "beans-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "verify:rate-limit": "node scripts/verify-rate-limit.mjs",
    "verify:rate-limit:memory": "node scripts/verify-rate-limit-memory.mjs",
    "verify:action-loading": "node scripts/verify-action-loading.mjs",
    "verify:google-trends": "node scripts/verify-google-trends.mjs && node scripts/verify-stories.mjs",
    "verify:discovery": "node scripts/verify-analytics.mjs && node scripts/verify-discovery.mjs",
    "db:migrate": "node scripts/user-database.mjs migrate",
    "db:reconcile": "node scripts/user-database.mjs reconcile",
    "verify:user-management": "node scripts/verify-user-management.mjs && node scripts/verify-user-management-ui.mjs && node scripts/verify-user-management-account.mjs",
    "verify:user-management:http": "node scripts/verify-user-management-http.mjs"
