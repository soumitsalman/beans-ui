# Server-only. Loaded into Nuxt runtimeConfig; never exposed to the client.
CAFECITO_API_KEY=
BEANS_API_BASE_URL=https://cafecito-beans-api.fly.dev
ESPRESSO_API_BASE_URL=https://cafecito-espresso-api.fly.dev
NUXT_PUBLIC_SITE_URL=https://beans.cafecito.tech
NUXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional local diagnostics; production reports final Web Vitals by default.
NUXT_PUBLIC_VITALS_REPORT_ALL_CHANGES=false
# Default score_threshold for topic searches. The browser sends it, so it is public. Blank or invalid values use 0.6.
NUXT_PUBLIC_DEFAULT_SCORE_THRESHOLD=0.6
