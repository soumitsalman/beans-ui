  "dependencies": {
    "@clerk/nuxt": "^3.1.18",
    "@iconify-json/lucide": "^1.2.100",
    "@iconify-json/simple-icons": "^1.2.75",
    "@nuxt/ui": "^4.6.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^5.10.1",
    "kysely": "^0.29.7",
    "markdown-it": "^14.1.1",
    "negotiator": "^1.1.0",
    "nuxt": "^4.4.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.2.2",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.6"
