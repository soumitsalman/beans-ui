# Server-only. Loaded into Nuxt runtimeConfig; never exposed to the client.
CAFECITO_API_KEY=
BEANS_API_BASE_URL=https://cafecito-beans-api.fly.dev
ESPRESSO_API_BASE_URL=https://cafecito-espresso-api.fly.dev
NUXT_PUBLIC_SITE_URL=https://beans.cafecito.tech
NUXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional local diagnostics; production reports final Web Vitals by default.
NUXT_PUBLIC_VITALS_REPORT_ALL_CHANGES=false
# Default score_threshold for topic searches. The browser sends it, so it is public. Blank or invalid values use 0.6.
NUXT_PUBLIC_DEFAULT_SCORE_THRESHOLD=0.6

# Required in production: same signing secret (32+ characters) on every Machine.
NUXT_RATE_LIMIT_COOKIE_SECRET=
# Optional: configured URL uses Redis; blank uses memory in each server process.
NUXT_RATE_LIMIT_REDIS_URL=
# Enable only behind Fly Proxy, without a CDN in front. Local development uses socket IP.
NUXT_RATE_LIMIT_TRUST_FLY=false

# Clerk development instance for local work. Never put secret/signing keys under NUXT_PUBLIC_.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
NUXT_CLERK_WEBHOOK_SIGNING_SECRET=
# Optional: PEM public key for networkless session verification.
NUXT_CLERK_JWT_KEY=
# Application-owned storage. PostgreSQL when configured; explicit SQLite alternative:
# BEANS_APP_USER_DB=sqlite:/absolute/path/to/local-users.sqlite
BEANS_APP_USER_DB=
